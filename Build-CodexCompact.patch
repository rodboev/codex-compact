+#[test]
+fn compact_main_view_fullscreen_appending_completing_and_removing_updates_head() {
+    use crate::transcript_view::tests::{render, text};
+    use codex_app_server_protocol::CommandExecutionSource::Agent;
+    let mut cells: Vec<Arc<dyn HistoryCell>> =
+        vec![Arc::new(compact_exec("one", "echo one", Agent, true))];
+    let mut view = TranscriptView::default();
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 command"
+    );
+    cells.push(compact_patch());
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 command, 1 edit"
+    );
+    let patch = crate::history_cell::new_patch_event(
+        std::collections::HashMap::from([(
+            std::path::PathBuf::from("/repo/pending.txt"),
+            crate::diff_model::FileChange::Add {
+                content: "pending\n".into(),
+            },
+        )]),
+        std::path::Path::new("/repo"),
+    )
+    .pending();
+    cells.push(Arc::new(patch.clone()));
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 command, 1 edit\n• Added pending.txt (+1 -0)"
+    );
+    patch.complete(codex_app_server_protocol::PatchApplyStatus::Completed);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 command, 2 edits"
+    );
+    cells.pop();
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 command, 1 edit"
+    );
+    cells.remove(0);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 edit"
+    );
+    let failed = patch.with_activity_id("failed".into()).pending();
+    cells.push(Arc::new(failed.clone()));
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 edit\n• Added pending.txt (+1 -0)"
+    );
+    failed.complete(codex_app_server_protocol::PatchApplyStatus::Failed);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 12)).trim_end(),
+        "• 1 edit"
+    );
+}
