+fn compact_command(id: &str, command: &str) -> crate::exec_cell::ExecCell {
+    let command = vec!["bash".into(), "-lc".into(), command.into()];
+    let parsed = codex_shell_command::parse_command::parse_command(&command);
+    let mut cell = crate::exec_cell::new_active_exec_command(
+        id.into(),
+        command,
+        parsed,
+        codex_app_server_protocol::CommandExecutionSource::Agent,
+        None,
+        false,
+    );
+    cell.complete_call(
+        id,
+        crate::exec_cell::CommandOutput::new(0, "retained output".into()),
+        std::time::Duration::ZERO,
+    );
+    cell
+}
+
+fn compact_patch() -> history_cell::PatchHistoryCell {
+    history_cell::new_patch_event(
+        std::collections::HashMap::from([(
+            std::path::PathBuf::from("/repo/file.txt"),
+            crate::diff_model::FileChange::Add {
+                content: "retained diff\n".into(),
+            },
+        )]),
+        std::path::Path::new("/repo"),
+    )
+}
+
+fn compact_scrollback_text(tui: &crate::tui::Tui) -> String {
+    tui.pending_history_lines_for_test()
+        .iter()
+        .map(rendered_line_text)
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn compact_buffer_text(app: &App) -> String {
+    app.initial_history_replay_buffer
+        .as_ref()
+        .unwrap()
+        .retained_lines
+        .iter()
+        .map(rendered_line_text)
+        .collect::<Vec<_>>()
+        .join("\n")
+}
