+    );
+    assert!(view.toggle_disclosure_at(&cells, 2, 0));
+    let expanded = text(&render(&mut view, &cells, 80, 20));
+    assert!(expanded.contains("echo one"), "{expanded}");
+    assert!(expanded.contains("c.txt"), "{expanded}");
+    assert!(
+        expanded.starts_with("• 1 command, 1 edit\n• Ran echo one\n• Added c.txt (+1 -0)"),
