+#[test]
+fn compact_main_view_prompt_header_click_jumps_to_its_user_cell() {
+    for prepend in [false, true] {
+        let mut cells = vec![
+            user("First question"),
+            cell("Earlier answer"),
+            user("Second question\nwith details"),
+            cell(
+                (1..=40)
+                    .map(|n| format!("answer line {n:02}"))
+                    .collect::<Vec<_>>()
+                    .join("\n"),
+            ),
+        ];
+        let mut view = TranscriptView::default();
+        let before = render(&mut view, &cells, 40, 8);
+        assert!(text(&before).starts_with("› Second question with details\nanswer line 34"));
+        let down = MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: 5,
+            row: 0,
+            modifiers: KeyModifiers::NONE,
+        };
+        assert!(view.handle_mouse(down, &cells).is_some());
+        assert_eq!(render(&mut view, &cells, 40, 8), before);
+        if prepend {
+            cells.insert(0, cell("Older history"));
+            view.history_loaded(&cells, 0..1);
+            assert_eq!(render(&mut view, &cells, 40, 8), before);
+        }
+        assert!(
+            view.handle_mouse(
+                MouseEvent {
+                    kind: MouseEventKind::Up(MouseButton::Left),
+                    ..down
+                },
+                &cells
+            )
+            .is_some()
+        );
+        assert_eq!(
+            text(&render(&mut view, &cells, 40, 8)).trim_end(),
+            "\n› Second question\n  with details\n\n\nanswer line 01\nanswer line 02\nanswer line 03"
+        );
+        assert!(!view.is_following());
+        assert!(view.selected_text(&cells).is_none());
+    }
+}
