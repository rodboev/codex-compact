+struct InlineActivityRenderable<'a> {
+    widget: &'a ChatWidget,
+    right: u16,
+}
+
+impl Renderable for InlineActivityRenderable<'_> {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let area = area.inset(Insets::tlbr(1, 0, 0, self.right));
+        let lines = self
+            .widget
+            .inline_activity_lines(area.width)
+            .unwrap_or_default();
+        let paragraph = HyperlinkParagraph::new(&lines, Style::default());
+        let overflow = paragraph
+            .line_count(area.width)
+            .saturating_sub(usize::from(area.height));
+        Clear.render(area, buf);
+        paragraph
+            .scroll(u16::try_from(overflow).unwrap_or(u16::MAX))
+            .render(area, buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        let width = width.saturating_sub(self.right).max(1);
+        let lines = self.widget.inline_activity_lines(width).unwrap_or_default();
+        if lines.is_empty() {
+            return 0;
+        }
+        (HyperlinkParagraph::new(&lines, Style::default()).line_count(width) as u16)
+            .saturating_add(1)
+    }
+}
