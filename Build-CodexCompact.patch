+fn compact_command_item(id: &str, command: &str) -> codex_app_server_protocol::ThreadItem {
+    use codex_app_server_protocol::*;
+    ThreadItem::CommandExecution {
+        model_context: None,
+        sandbox_type: None,
+        id: id.into(),
+        command: command.into(),
+        cwd: codex_utils_absolute_path::AbsolutePathBuf::try_from("/repo")
+            .unwrap()
+            .into(),
+        process_id: None,
+        plugin_id: None,
+        script_path: None,
+        source: CommandExecutionSource::Agent,
+        status: CommandExecutionStatus::Completed,
+        command_actions: vec![],
+        aggregated_output: Some("retained output".into()),
+        exit_code: Some(0),
+        duration_ms: Some(1),
+    }
+}
+
+fn compact_drain_events(
+    app: &mut App,
+    tui: &mut crate::tui::Tui,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<crate::app_event::AppEvent>,
+) {
+    while let Ok(event) = events.try_recv() {
+        match event {
+            crate::app_event::AppEvent::InsertHistoryCell(cell) => {
+                app.insert_history_cell(tui, cell)
+            }
+            crate::app_event::AppEvent::EndActivityRun => app.end_activity_run(tui),
+            _ => {}
+        }
+    }
+}
