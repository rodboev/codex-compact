+#[test]
+fn compact_main_view_fullscreen_collapse_keeps_clicked_member_on_screen() {
+    use crate::transcript_view::tests::{render, text};
+    use codex_app_server_protocol::CommandExecutionSource::Agent;
+    let mut command = compact_exec("long", "echo long", Agent, true);
+    command.complete_call(
+        "long",
+        crate::exec_cell::CommandOutput::new(
+            0,
+            (0..100).map(|n| format!("output {n}\n")).collect(),
+        ),
+        std::time::Duration::ZERO,
+    );
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![
+        Arc::new(crate::history_cell::PlainHistoryCell::new(
+            (0..40).map(|n| format!("context {n}").into()).collect(),
+        )),
+        Arc::new(command),
+        Arc::new(compact_exec("next", "echo next", Agent, true)),
+        Arc::new(crate::history_cell::PlainHistoryCell::new(vec![
+            "answer"
+                .into();
+            6
+        ])),
+    ];
+    let mut view = TranscriptView::default();
+    let initial = text(&render(&mut view, &cells, 80, 16));
+    let summary_row = initial
+        .lines()
+        .position(|row| row == "• 2 commands")
+        .unwrap() as u16;
+    compact_click(&mut view, &cells, summary_row);
+    render(&mut view, &cells, 80, 16);
+    compact_click(&mut view, &cells, summary_row + 1);
+    render(&mut view, &cells, 80, 16);
+    view.scroll(&cells, 20);
+    let detail = text(&render(&mut view, &cells, 80, 16));
+    assert!(
+        detail.lines().nth(6).unwrap().starts_with("output "),
+        "{detail}"
+    );
+    compact_click(&mut view, &cells, 6);
+    let collapsed = text(&render(&mut view, &cells, 80, 16));
+    assert_eq!(collapsed.lines().nth(6), Some("• Ran echo long"));
+    assert_eq!(collapsed.lines().nth(5), Some("• 2 commands"));
+    compact_click(&mut view, &cells, 5);
+    let collapsed = text(&render(&mut view, &cells, 80, 16));
+    assert_eq!(collapsed.lines().nth(5), Some("• 2 commands"));
+    assert!(!collapsed.contains("Ran echo"), "{collapsed}");
+}
