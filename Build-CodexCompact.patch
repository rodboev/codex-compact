+//! Project compact runs onto their first visible member while retaining per-cell identities.
+
+use crate::history_cell::ActivitySummary;
+
+use super::*;
+
+#[derive(Default)]
+pub(super) struct ActivityRuns {
+    key: Option<(u64, usize, usize, u16)>,
+    entries: Vec<Option<usize>>,
+    runs: Vec<ActivityRun>,
+}
+
+#[derive(Default)]
+pub(super) struct ActivityRun {
+    pub(super) head: Option<usize>,
+    pub(super) summary: ActivitySummary,
+    pub(super) ids: Vec<String>,
+    pub(super) expanded: bool,
+    pub(super) id: String,
+    members: Vec<usize>,
+}
+
+impl TranscriptView {
+    pub(super) fn groups_activity(&self) -> bool {
+        !self.detailed && self.mode == HistoryRenderMode::Rich && !self.file_edits_only
+    }
+
+    pub(crate) fn sync_live_activity_summary(&mut self, summary: Option<ActivitySummary>) {
+        if self.live_activity != summary {
+            self.live_activity = summary;
+            self.activity_runs.key = None;
+            self.live_key = None;
+        }
+    }
+
+    pub(super) fn compact_activity_run(
+        &self,
+        cells: &[Arc<dyn HistoryCell>],
+        index: usize,
+    ) -> Option<&ActivityRun> {
+        if !self.groups_activity()
+            || self.activity_runs.key.is_none_or(|(_, source, len, _)| {
+                source != cells.as_ptr() as usize || len != cells.len()
+            })
+        {
+            return None;
+        }
+        let run = self.activity_runs.entries.get(index).copied().flatten()?;
+        self.activity_runs.runs.get(run)
+    }
+
+    pub(super) fn prepare_activity_run(&mut self, cells: &[Arc<dyn HistoryCell>], index: usize) {
+        if !self.groups_activity() {
+            return;
+        }
+        let width = self.area.width.max(1);
+        let key = (
+            self.cache.frame(),
+            cells.as_ptr() as usize,
+            cells.len(),
+            width,
+        );
+        if self.activity_runs.key != Some(key) {
+            self.activity_runs.key = Some(key);
+            self.activity_runs.entries = vec![None; cells.len() + 1];
+            self.activity_runs.runs.clear();
+        }
+        if index > cells.len()
+            || self.activity_runs.entries[index].is_some()
+            || cells
+                .get(index)
+                .map_or(self.live_activity.is_none(), |cell| {
+                    cell.activity_summary().is_none()
+                })
+        {
+            return;
+        }
+        let mut first = index;
+        while first > 0 && !self.ends_activity_run(cells, first - 1) {
+            first -= 1;
+        }
+        let mut run = ActivityRun::default();
+        let mut end = first;
+        while end < cells.len() && !self.ends_activity_run(cells, end) {
+            let cell = &cells[end];
+            if let Some(summary) = cell.activity_summary() {
+                if run.head.is_none()
+                    && (!summary.is_empty() || !cell.running_activity_lines(width).is_empty())
+                {
+                    run.head = Some(end);
+                }
+                run.summary.extend(summary);
+                let ids = cell.activity_ids();
+                if ids.is_empty() && !summary.is_empty() {
+                    run.ids.push(format!("activity:{:?}", EntryKey::cell(cell)));
+                } else {
+                    run.ids.extend(ids);
+                }
+                run.members.push(end);
+            }
+            end += 1;
+        }
+        if end == cells.len()
+            && let Some(summary) = self.live_activity
+        {
+            run.head.get_or_insert(cells.len());
+            run.summary.extend(summary);
+            run.ids.extend(self.disclosure.live_ids.iter().cloned());
+            run.members.push(cells.len());
+        }
+        run.id = format!("run:{}", run.ids.first().cloned().unwrap_or_default());
+        run.expanded = self.disclosure.expanded.contains(&run.id);
+        self.activity_runs.push(run);
+    }
+
+    fn ends_activity_run(&mut self, cells: &[Arc<dyn HistoryCell>], index: usize) -> bool {
+        let cell = &cells[index];
+        cell.activity_summary().is_none()
+            && (cell
+                .as_any()
+                .is::<crate::history_cell::FinalMessageSeparator>()
+                || self
+                    .entry_layout(cells, index, false)
+                    .is_some_and(|layout| layout.row_count() > 0))
+    }
+}
+
+impl ActivityRuns {
+    fn push(&mut self, run: ActivityRun) {
+        if run.members.is_empty() {
+            return;
+        }
+        for index in &run.members {
+            self.entries[*index] = Some(self.runs.len());
+        }
+        self.runs.push(run);
+    }
+
+    pub(super) fn invalidate(&mut self) {
+        self.key = None;
+    }
+}
+
+pub(crate) struct ActivityMember {
+    pub(crate) ids: Vec<String>,
+    pub(crate) lines: Vec<crate::terminal_hyperlinks::HyperlinkLine>,
+}
+
+pub(super) fn member_layout(
+    summary: Option<(ActivitySummary, String)>,
+    members: Vec<ActivityMember>,
+    width: u16,
+) -> TextLayout {
+    let mut lines = Vec::new();
+    let mut regions = Vec::new();
+    let mut offset = 0;
+    let summary = summary.map(|(summary, id)| ActivityMember {
+        ids: vec![id],
+        lines: summary.lines(width),
+    });
+    for member in summary.into_iter().chain(members) {
+        if member.lines.is_empty() {
+            continue;
+        }
+        let len = TextLayout::new(member.lines.clone(), width).text().len();
+        if !member.ids.is_empty() {
+            regions.push(super::text::ActivityRegion {
+                source: offset..offset + len + 1,
+                ids: member.ids,
+            });
+        }
+        offset += len + 1;
+        lines.extend(member.lines);
+    }
+    let mut layout = TextLayout::new(lines, width);
+    layout.disclosure = !regions.is_empty();
+    layout.activity_regions = regions;
+    layout
+}
