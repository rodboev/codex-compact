+        "• Running echo live"
+    );
+    for key in [KeyCode::F(4), KeyCode::Enter] {
+        view.handle_key(KeyEvent::new(key, KeyModifiers::NONE), &cells);
+        sync(&mut view, &chat, &cells, 80);
+        render(&mut view, &cells, 80, 20);
+    }
+    let expanded = text(&render(&mut view, &cells, 80, 20));
+    assert!(expanded.contains("$ echo live"), "{expanded}");
+    chat.transcript
+        .active_cell
+        .as_mut()
+        .unwrap()
+        .as_any_mut()
+        .downcast_mut::<ExecCell>()
+        .unwrap()
+        .complete_call(
+            "live",
+            crate::exec_cell::CommandOutput::new(0, "live output\n".into()),
+            Duration::ZERO,
+        );
+    chat.flush_active_cell();
+    while let Ok(event) = events.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = event {
+            cells.push(cell.into());
+        }
+    }
+    for width in [80, 40] {
+        sync(&mut view, &chat, &cells, width);
+        let displayed = text(&render(&mut view, &cells, width, 20));
+        assert!(
+            displayed.starts_with("• 1 command\n$ echo live\nlive output"),
+            "{displayed}"
+        );
+    }
+    view.handle_key(KeyEvent::new(KeyCode::Left, KeyModifiers::NONE), &cells);
+    assert_eq!(
+        text(&render(&mut view, &cells, 40, 20)).trim_end(),
+        "• 1 command\n• Ran echo live"
+    );
+    for key in [KeyCode::Home, KeyCode::Left] {
+        view.handle_key(KeyEvent::new(key, KeyModifiers::NONE), &cells);
+        render(&mut view, &cells, 40, 20);
+    }
+    assert_eq!(
+        text(&render(&mut view, &cells, 40, 20)).trim_end(),
+        "• 1 command"
+    );
+}
