+fn compact_exec(
+    id: &str,
+    command: &str,
+    source: codex_app_server_protocol::CommandExecutionSource,
+    finished: bool,
+) -> crate::exec_cell::ExecCell {
+    let command = vec!["bash".into(), "-lc".into(), command.into()];
+    let parsed = codex_shell_command::parse_command::parse_command(&command);
+    let mut cell =
+        crate::exec_cell::new_active_exec_command(id.into(), command, parsed, source, None, false);
+    if finished {
+        cell.complete_call(
+            id,
+            crate::exec_cell::CommandOutput::new(0, "retained output".into()),
+            std::time::Duration::ZERO,
+        );
+    }
+    cell
+}
+
+fn compact_patch() -> Arc<dyn HistoryCell> {
+    Arc::new(crate::history_cell::new_patch_event(
+        std::collections::HashMap::from([(
+            std::path::PathBuf::from("/repo/c.txt"),
+            crate::diff_model::FileChange::Add {
+                content: "body\n".into(),
+            },
+        )]),
+        std::path::Path::new("/repo"),
+    ))
+}
