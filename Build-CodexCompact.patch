+#[tokio::test]
+async fn compact_main_view_agent_message_commits_one_summary() -> Result<()> {
+    let mut app = make_test_app().await;
+    app.local_settings.tui.terminal_resize_reflow_max_rows = Some(128);
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::new_user_prompt(
+            "Input".into(),
+            vec![],
+            vec![],
+            vec![],
+        )),
+    );
+    let input = compact_scrollback_text(&tui);
+    app.insert_history_cell(&mut tui, Box::new(compact_command("one", "cargo test")));
+    app.insert_history_cell(&mut tui, Box::new(compact_patch()));
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::new_unified_exec_interaction(
+            None,
+            String::new(),
+        )),
+    );
+    app.insert_history_cell(&mut tui, Box::new(compact_command("two", "cargo fmt")));
+    assert_eq!(compact_scrollback_text(&tui), input);
+    let live = app
+        .chat_widget
+        .active_cell_display_hyperlink_lines(80)
+        .unwrap();
+    assert_eq!(
+        live.iter().map(rendered_line_text).collect::<Vec<_>>(),
+        ["• 2 commands, 1 edit"]
+    );
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::AgentMarkdownCell::new(
+            "Answer".into(),
+            std::path::Path::new("/repo"),
+        )),
+    );
+    let output = compact_scrollback_text(&tui);
+    assert_eq!(output, "\n› Input\n\n\n• 2 commands, 1 edit\n\n• Answer");
+    assert!(
+        app.chat_widget
+            .active_cell_display_hyperlink_lines(80)
+            .is_none()
+    );
+    let details = app
+        .transcript_cells
+        .iter()
+        .flat_map(|cell| cell.transcript_lines(80))
+        .map(|line| line.to_string())
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(details.contains("retained output"));
+    assert!(details.contains("retained diff"));
+    assert!(details.contains("Waited for background terminal"));
+    Ok(())
+}
