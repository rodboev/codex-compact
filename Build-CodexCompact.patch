+#[test]
+fn compact_main_view_fullscreen_computer_calls_disclose_individually() {
+    use crate::history_cell::{ComputerActivityCell, McpInvocation, McpToolCallCell};
+    use crate::transcript_view::tests::{render, text};
+    let mut computer = ComputerActivityCell::default();
+    for (id, title, output) in [
+        ("inspect", "Inspect page", "page details"),
+        ("click", "Click button", "button details"),
+    ] {
+        computer.complete(
+            McpToolCallCell::new(
+                id.into(),
+                McpInvocation {
+                    server: "cua_repl".into(),
+                    tool: "js".into(),
+                    arguments: Some(serde_json::json!({"title": title, "code": "run()"})),
+                },
+                false,
+            ),
+            std::time::Duration::ZERO,
+            Ok(codex_protocol::mcp::CallToolResult {
+                content: vec![serde_json::json!({"type": "text", "text": output})],
+                structured_content: None,
+                is_error: Some(false),
+                meta: None,
+            }),
+        );
+    }
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(computer)];
+    let mut view = TranscriptView::default();
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 20)).trim_end(),
+        "• 2 tools"
+    );
+    compact_click(&mut view, &cells, 0);
+    let level_one = "• 2 tools\n• Called Inspect page\n• Called Click button";
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 20)).trim_end(),
+        level_one
+    );
+    compact_click(&mut view, &cells, 1);
+    let details = text(&render(&mut view, &cells, 80, 20));
+    assert!(details.contains("page details"), "{details}");
+    assert!(!details.contains("button details"), "{details}");
+    let row = details
+        .lines()
+        .position(|line| line.contains("page details"))
+        .unwrap() as u16;
+    compact_click(&mut view, &cells, row);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 20)).trim_end(),
+        level_one
+    );
+}
