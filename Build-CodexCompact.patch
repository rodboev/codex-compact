diff --git a/codex-rs/tui/src/history_cell/activity_summary.rs b/codex-rs/tui/src/history_cell/activity_summary.rs
new file mode 100644
index 0000000..570c653
--- /dev/null
+++ b/codex-rs/tui/src/history_cell/activity_summary.rs
@@ -0,0 +1,82 @@
+//! Counts finished calls without changing their retained transcript cells.
+
+use super::*;
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum ActivityKind {
+    Command,
+    Edit,
+    Read,
+    Search,
+    Agent,
+    Tool,
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) struct ActivitySummary {
+    counts: [usize; 6],
+}
+
+impl ActivitySummary {
+    pub(crate) fn record(&mut self, kind: ActivityKind) {
+        self.counts[kind as usize] += 1;
+    }
+
+    pub(crate) fn extend(&mut self, other: Self) {
+        for (count, additional) in self.counts.iter_mut().zip(other.counts) {
+            *count += additional;
+        }
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.counts == [0; 6]
+    }
+
+    pub(crate) fn lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        let label = self
+            .counts
+            .iter()
+            .zip(["command", "edit", "read", "search", "agent", "tool"])
+            .filter(|(count, _)| **count > 0)
+            .map(|(count, kind)| format!("{count} {kind}{}", if *count == 1 { "" } else { "s" }))
+            .collect::<Vec<_>>()
+            .join(", ");
+        if label.is_empty() {
+            return Vec::new();
+        }
+        vec![activity_preview::clipped_line(
+            Line::from(vec!["• ".dim(), label.into()]),
+            width,
+        )]
+    }
+
+    /// Invisible cells preserve adjacency; even an invisible turn separator closes the run.
+    pub(crate) fn render_cell(
+        &mut self,
+        cell: &dyn HistoryCell,
+        width: u16,
+        mode: HistoryRenderMode,
+    ) -> Vec<HyperlinkLine> {
+        if mode == HistoryRenderMode::Rich
+            && let Some(summary) = cell.activity_summary()
+        {
+            self.extend(summary);
+            return Vec::new();
+        }
+        let lines = cell.display_hyperlink_lines_for_mode(width, mode);
+        if mode != HistoryRenderMode::Rich
+            || (lines.is_empty() && !cell.as_any().is::<FinalMessageSeparator>())
+        {
+            return lines;
+        }
+        let mut prefix = std::mem::take(self).lines(width);
+        if prefix.is_empty() {
+            return lines;
+        }
+        if !lines.is_empty() {
+            prefix.push(HyperlinkLine::from(""));
+        }
+        prefix.extend(lines);
+        prefix
+    }
+}
