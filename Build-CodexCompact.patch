+#[test]
+fn compact_main_view_fullscreen_summarizes_tool_run() {
+    use crate::transcript_view::tests::{render, text};
+    use codex_app_server_protocol::CommandExecutionSource::Agent;
+    let mut cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(
+        crate::history_cell::new_user_prompt("Run commands".into(), vec![], vec![], vec![]),
+    )];
+    for (id, command) in [
+        ("one", "echo one"),
+        ("two", "echo two"),
+        ("date", "date"),
+        ("wc", "wc -c a.txt"),
+    ] {
+        cells.push(Arc::new(compact_exec(id, command, Agent, true)));
+    }
+    cells.push(compact_patch());
+    cells.push(Arc::new(crate::history_cell::AgentMarkdownCell::new(
+        "DONE".into(),
+        std::path::Path::new("/repo"),
+    )));
+    let mut view = TranscriptView::default();
+    let compact = text(&render(&mut view, &cells, 80, 16));
+    assert_eq!(
+        compact.trim(),
+        "› Run commands\n\n\n• 4 commands, 1 edit\n\n• DONE"
+    );
+    view.set_presentation(true, HistoryRenderMode::Rich);
+    let detailed = text(&render(&mut view, &cells, 80, 40));
+    assert!(detailed.contains("retained output"), "{detailed}");
+    assert!(detailed.contains("body"), "{detailed}");
+    view.set_presentation(false, HistoryRenderMode::Raw);
+    let raw = text(&render(&mut view, &cells, 80, 40));
+    assert!(raw.contains("echo one"), "{raw}");
+    assert!(!raw.contains("4 commands"), "{raw}");
+}
