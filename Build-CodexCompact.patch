+            FileChange::Update {
+                unified_diff: update,
+                move_path: Some(cwd.join("after.txt")),
+            },
+            "new-content",
+        ),
+    ];
+    let mut headers = Vec::new();
+    for (name, change, content) in cases {
+        let cell = new_patch_event(HashMap::from([(cwd.join(name), change)]), &cwd);
+        for width in [12, 80, 120] {
+            let lines = cell.display_lines_for_mode(width, HistoryRenderMode::Rich);
+            assert_eq!(lines.len(), 1);
+            assert!(!render_lines(&lines).join("\n").contains(content));
+        }
+        headers.extend(render_lines(&compact_run_lines(&[&cell], 120)));
+        assert!(
+            render_lines(&cell.transcript_lines(/*width*/ 120))
+                .join("\n")
+                .contains(content)
+        );
+        assert!(render_lines(&cell.raw_lines()).join("\n").contains(content));
+    }
+    insta::assert_snapshot!(headers.join("\n"), @r"
+    • 1 edit
+    • 1 edit
+    • 1 edit
+    • 1 edit
+    ");
+}
