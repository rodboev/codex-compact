+#[test]
+fn compact_main_view_hides_search_progress_and_preserves_completed_searches() {
+    for animations_enabled in [false, true] {
+        let mut cell =
+            new_active_web_search_call("search".into(), String::new(), animations_enabled);
+        assert!(
+            cell.display_lines_for_mode(/*width*/ 80, HistoryRenderMode::Rich)
+                .is_empty()
+        );
+        assert_eq!(cell.desired_height(/*width*/ 80), 0);
+        let url = "https://github.com/microsoft/terminal/issues/20477";
+        cell.update(
+            WebSearchAction::OpenPage {
+                url: Some(url.into()),
+            },
+            String::new(),
+        );
+        assert!(
+            cell.display_lines_for_mode(/*width*/ 80, HistoryRenderMode::Rich)
+                .is_empty()
+        );
+        assert!(
+            render_lines(&cell.transcript_lines(/*width*/ 120))
+                .join("\n")
+                .contains(url)
+        );
+        cell.complete();
+        for width in [20, 80, 120] {
+            assert_eq!(
+                cell.display_lines_for_mode(width, HistoryRenderMode::Rich),
+                cell.display_lines(width)
+            );
+        }
+        insta::allow_duplicates! {
+            insta::assert_snapshot!(render_lines(&compact_run_lines(&[&cell], 120)).join("\n"), @"• 1 search");
+        }
+    }
+}
