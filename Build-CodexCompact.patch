+        view.handle_mouse(
+            MouseEvent {
+                kind,
+                column,
+                row: 3,
+                modifiers: KeyModifiers::NONE,
+            },
+            &cells,
+        );
+    }
+    assert_eq!(view.selected_text(&cells).as_deref(), Some("retained"));
+    assert_eq!(text(&render(&mut view, &cells, 80, 24)), details);
+    compact_click(&mut view, &cells, 3);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 24)).trim_end(),
+        level_one
+    );
+    compact_click(&mut view, &cells, 4);
+    assert!(text(&render(&mut view, &cells, 80, 24)).contains("body"));
+    compact_click(&mut view, &cells, 0);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 24)).trim_end(),
+        "• 1 command, 1 edit, 2 reads"
+    );
+    compact_click(&mut view, &cells, 0);
+    assert_eq!(
+        text(&render(&mut view, &cells, 80, 24)).trim_end(),
+        level_one
+    );
+}
