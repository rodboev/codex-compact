+#[test]
+fn compact_main_view_fullscreen_keyboard_disclosure_levels() {
+    use crate::transcript_view::tests::{render, text};
+    use codex_app_server_protocol::CommandExecutionSource::Agent;
+    use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![
+        Arc::new(compact_exec("one", "echo one", Agent, true)),
+        compact_patch(),
+    ];
+    let mut view = TranscriptView::default();
+    render(&mut view, &cells, 80, 24);
+    for (keys, expected) in [
+        (
+            vec![KeyCode::F(4), KeyCode::Enter],
+            "• 1 command, 1 edit\n• Ran echo one\n• Added c.txt (+1 -0)",
+        ),
+        (
+            vec![KeyCode::Down, KeyCode::Enter],
+            "$ echo one\nretained output",
+        ),
+        (
+            vec![KeyCode::Enter],
+            "• 1 command, 1 edit\n• Ran echo one\n• Added c.txt (+1 -0)",
+        ),
+        (vec![KeyCode::Right], "$ echo one\nretained output"),
+        (
+            vec![KeyCode::Left],
+            "• 1 command, 1 edit\n• Ran echo one\n• Added c.txt (+1 -0)",
+        ),
+        (vec![KeyCode::Home, KeyCode::Left], "• 1 command, 1 edit"),
+    ] {
+        for key in keys {
+            assert!(
+                view.handle_key(KeyEvent::new(key, KeyModifiers::NONE), &cells)
+                    .is_some()
+            );
+            render(&mut view, &cells, 80, 24);
+        }
+        let rendered = text(&render(&mut view, &cells, 80, 24));
+        if expected.starts_with('$') {
+            assert!(rendered.contains(expected), "{rendered}");
+        } else {
+            assert_eq!(rendered.trim_end(), expected);
+        }
+    }
+}
