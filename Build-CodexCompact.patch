+#[test]
+fn compact_main_view_prompt_header_drag_selects_without_jumping() {
+    let cells = vec![
+        user("Question"),
+        cell(
+            (1..=40)
+                .map(|n| format!("answer line {n:02}"))
+                .collect::<Vec<_>>()
+                .join("\n"),
+        ),
+    ];
+    for (start_row, end_row) in [(0, 1), (1, 0)] {
+        let mut view = TranscriptView::default();
+        let before = render(&mut view, &cells, 40, 8);
+        let down = MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: 2,
+            row: start_row,
+            modifiers: KeyModifiers::NONE,
+        };
+        view.handle_mouse(down, &cells);
+        assert_eq!(render(&mut view, &cells, 40, 8), before);
+        for kind in [
+            MouseEventKind::Drag(MouseButton::Left),
+            MouseEventKind::Up(MouseButton::Left),
+        ] {
+            view.handle_mouse(
+                MouseEvent {
+                    kind,
+                    column: 6,
+                    row: end_row,
+                    ..down
+                },
+                &cells,
+            );
+            assert_eq!(text(&render(&mut view, &cells, 40, 8)), text(&before));
+        }
+        assert_eq!(view.selected_text(&cells).as_deref(), Some("swer"));
+        let Some(ViewAction::Copy(copied)) = view.handle_key(
+            KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL),
+            &cells,
+        ) else {
+            panic!("copy header drag");
+        };
+        assert_eq!(copied, "swer");
+    }
+}
